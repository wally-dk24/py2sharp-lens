# Py2Sharp Lens configuration. Copy to `.env` and adjust. NEVER commit `.env`.
# Default is annotate-only mode: no LLM calls, no keys needed.

# Provider: "none" (default) | "openai_compat" | "anthropic" | "manual"
LLM_PROVIDER=none

# OpenAI-compatible provider settings (Ollama, Groq, OpenRouter, Gemini).
# Ollama needs no key; leave LLM_API_KEY empty for local models.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=

# Optional: cap completion tokens (standard param). Useful for reasoning
# models that can burn the whole budget "thinking" and return empty content.
#LLM_MAX_TOKENS=4000
# Optional, provider-specific: curb the reasoning budget (Pollinations
# honors "low"). Leave commented out for providers that don't know it.
#LLM_REASONING_EFFORT=low

# Anthropic provider settings (optional dependency: pip install anthropic).
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
